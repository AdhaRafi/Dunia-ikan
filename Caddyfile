{
    auto_https off
    frankenphp
}

:{$PORT:80} {
    root * /app/public
    encode zstd gzip

    @immutable path /build/* /images/* /videos/* /css/* /js/* /fonts/* /favicon.ico /favicon.png
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    header @immutable CDN-Cache-Control "public, max-age=31536000, immutable"

    php_server {
        resolve_root_symlink
    }
}
